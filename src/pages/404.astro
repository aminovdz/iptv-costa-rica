---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import { AlertTriangle, ArrowLeft } from 'lucide-astro';
---

<Layout 
  title="404 - Página No Encontrada | IPTV Costa Rica" 
  description="Error 404. La página que busca no existe."
>
  <StickyHeader />
  
  <main class="flex-grow flex items-center justify-center py-32 text-center min-h-[70vh]">
    <div class="max-w-xl mx-auto px-4">
      <div class="w-24 h-24 bg-red-500/10 rounded-full flex items-center justify-center mx-auto mb-8 relative">
        <AlertTriangle class="w-12 h-12 text-secondary" aria-hidden="true" />
        <div class="absolute -top-2 -right-2 bg-secondary text-white text-xs font-bold px-2 py-1 rounded-md">404</div>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6">La Señal se Perdió</h1>
      <p class="text-xl text-textSecondary mb-10">
        No pudimos sintonizar la página que está buscando. Es posible que el enlace esté roto o haya sido movido.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="flex items-center justify-center gap-2 bg-primary hover:bg-blue-700 text-white px-8 py-4 rounded-full font-bold transition-all shadow-lg">
          <ArrowLeft class="w-5 h-5" aria-hidden="true" /> Volver al Inicio
        </a>
        <a href="/contact" class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-full font-bold transition-all border border-white/10">
          Contactar Soporte
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
