---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import LiveScores from '../../components/LiveScores.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import PricingCard from '../../components/PricingCard.astro';
import ReferralBanner from '../../components/ReferralBanner.astro';
import UserReviewsSection from '../../components/UserReviewsSection.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import SupportedDevices from '../../components/SupportedDevices.astro';
import CitiesList from '../../components/CitiesList.astro';
import ContactForm from '../../components/ContactForm.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';

import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { PlayCircle, CheckCircle2, Star } from 'lucide-astro';

export function getStaticPaths() {
  return [
    { params: { city: 'san-jose' }, props: { name: 'San José' } },
    { params: { city: 'alajuela' }, props: { name: 'Alajuela' } },
    { params: { city: 'cartago' }, props: { name: 'Cartago' } }
  ];
}

const { city } = Astro.params;
const { name } = Astro.props;

const title = `Mejor IPTV en ${name} — Televisión Premium 2025`;
const description = `El mejor proveedor de IPTV en ${name}. Todos los canales nacionales, la Liga FPD en vivo y películas en 4K. Active hoy con Tarjetas y Cripto.`;

const localSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `IPTV Costa Rica - Cobertura en ${name}`,
  "description": "Proveedor líder de IPTV sirviendo clientes locales con la mejor señal en alta definición.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": name,
    "addressCountry": "CR"
  }
});
---

<Layout title={title} description={description} schema={localSchema}>
  <StickyHeader />
  
  <main>
    <!-- Dynamic Localized Hero -->
    <section class="relative pt-32 pb-20 overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/20 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8 backdrop-blur-md">
          <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse" aria-hidden="true"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-green-400">Servicio Disponible en {name}</span>
        </div>
        
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 bg-gradient-to-br from-white to-textSecondary bg-clip-text text-transparent max-w-4xl mx-auto leading-tight">
          El Mejor Servicio de IPTV para <span class="text-white">{name}</span>
        </h1>
        
        <p class="text-lg md:text-xl text-textSecondary max-w-2xl mx-auto mb-10">
          Únase a cientos de clientes satisfechos en {name} que ya disfrutan de la mejor televisión sin cables. Canales ticos, deportes en vivo y calidad 4K sin interrupciones.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="https://wa.me/18036582620" class="flex items-center gap-2 bg-secondary hover:bg-red-700 text-white px-8 py-4 rounded-full font-bold text-lg transition-all shadow-[0_0_20px_rgba(206,17,38,0.4)] hover:-translate-y-1">
            <PlayCircle class="w-5 h-5" aria-hidden="true" />
            Prueba Gratis en {name}
          </a>
        </div>
      </div>
    </section>

    <!-- Standard Stack -->
    <LiveScores />
    <FeatureGrid />
    <PricingCard />
    <ReferralBanner />
    <UserReviewsSection />
    <ProcessSteps />
    <SupportedDevices />
    <CitiesList />
    <ContactForm />
    <FAQSection />
    <CTASection />
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
