---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import LiveScores from '../components/LiveScores.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import CitiesList from '../components/CitiesList.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

// Engagement Widgets
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Suscripción IPTV Costa Rica",
  "description": "El mejor servicio de IPTV en Costa Rica con canales nacionales, Liga FPD y calidad 4K.",
  "brand": {
    "@type": "Brand",
    "name": "IPTV Costa Rica"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "524"
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "5.00",
    "highPrice": "35.00",
    "priceCurrency": "USD",
    "offerCount": "4"
  }
});
---

<Layout 
  title="IPTV Costa Rica — Todos los Canales Ticos en HD y 4K" 
  description="La mejor televisión de Costa Rica, sin cables y sin complicaciones. Pruebe gratis por 24 horas y vea la Liga FPD en vivo. Aceptamos Tarjetas y Cripto."
  schema={schema}
>
  <StickyHeader />
  
  <main>
    <Hero />
    <LiveScores />
    <FeatureGrid />
    <PricingCard />
    <ReferralBanner />
    <UserReviewsSection />
    <ProcessSteps />
    <SupportedDevices />
    <CitiesList />
    <ContactForm />
    <FAQSection />
    <CTASection />
  </main>

  <Footer />
  
  <!-- Global Engagement Widgets -->
  <FloatingWhatsApp />
  <GroupsPopup />
  <ExitPopup />
  <SocialPopup />
</Layout>
