---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import LiveScores from '../components/LiveScores.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import CitiesList from '../components/CitiesList.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';

// V2 targets "Mejor IPTV Costa Rica"
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Mejor IPTV Costa Rica Premium",
  "description": "El servicio IPTV mejor calificado de Costa Rica. Confiabilidad 4K/8K sin interrupciones.",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "890"
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "5.00",
    "highPrice": "35.00",
    "priceCurrency": "USD"
  }
});
---

<Layout 
  title="Mejor IPTV Costa Rica 2025 — Comparación y Servicio Premium" 
  description="Descubra por qué somos considerados el mejor IPTV en Costa Rica. 100% libre de cortes, con canales Ticos, Liga FPD y soporte VIP."
  schema={schema}
>
  <StickyHeader />
  
  <main>
    <Hero />
    <LiveScores />
    <FeatureGrid />
    <PricingCard />
    <ReferralBanner />
    <UserReviewsSection />
    <ProcessSteps />
    <SupportedDevices />
    <CitiesList />
    <ContactForm />
    <FAQSection />
    <CTASection />
  </main>

  <Footer />
  
  <FloatingWhatsApp />
  <GroupsPopup />
  <ExitPopup />
  <SocialPopup />
</Layout>
