---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import LiveScores from '../components/LiveScores.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import CitiesList from '../components/CitiesList.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';

// V3 targets "Canales IPTV Costa Rica" and "Ver futbol en vivo"
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Paquete Deportivo y Canales IPTV Costa Rica",
  "description": "Vea fútbol en vivo en Costa Rica: Liga FPD, La Sele, Champions y más de 10,000 canales.",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "412"
  }
});
---

<Layout 
  title="Canales IPTV Costa Rica — Vea Fútbol en Vivo (Liga FPD)" 
  description="Acceda a la mejor lista de canales IPTV en Costa Rica. Deportes en vivo, Teletica, Repretel y canales internacionales en calidad HD y 4K."
  schema={schema}
>
  <StickyHeader />
  
  <main>
    <Hero />
    <LiveScores />
    <FeatureGrid />
    <PricingCard />
    <ReferralBanner />
    <UserReviewsSection />
    <ProcessSteps />
    <SupportedDevices />
    <CitiesList />
    <ContactForm />
    <FAQSection />
    <CTASection />
  </main>

  <Footer />
  
  <FloatingWhatsApp />
  <GroupsPopup />
  <ExitPopup />
  <SocialPopup />
</Layout>
