---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('guides');
// Sort by date descending
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout 
  title="Guías y Blog de IPTV en Costa Rica | IPTV Costa Rica" 
  description="Aprenda cómo configurar su IPTV, ver fútbol en vivo y aprovechar al máximo su servicio de streaming en Costa Rica."
>
  <StickyHeader />
  
  <main class="py-24 min-h-[80vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6">Centro de Conocimiento</h1>
        <p class="text-lg text-textSecondary max-w-2xl mx-auto">
          Manténgase al día con nuestros últimos tutoriales, noticias deportivas y guías técnicas para disfrutar de la mejor televisión.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => (
          <a href={`/guides/${post.slug}`} class="glass-panel border border-white/5 rounded-2xl overflow-hidden hover:-translate-y-2 transition-transform group flex flex-col h-full">
            {post.data.heroImage && (
              <img src={post.data.heroImage} alt={post.data.title} class="w-full h-48 object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
            )}
            <div class="p-6 flex flex-col flex-grow">
              <span class="text-primary text-xs font-bold uppercase tracking-wider mb-2">
                {post.data.pubDate.toLocaleDateString('es-CR', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
              <h2 class="text-xl font-bold text-white mb-3 group-hover:text-primary transition-colors line-clamp-2">
                {post.data.title}
              </h2>
              <p class="text-textSecondary text-sm mb-4 line-clamp-3">
                {post.data.description}
              </p>
              <div class="mt-auto text-primary text-sm font-semibold flex items-center gap-1 group-hover:gap-2 transition-all">
                Leer artículo &rarr;
              </div>
            </div>
          </a>
        ))}
        {posts.length === 0 && (
          <div class="col-span-full text-center text-textSecondary py-12">
            Nuevos artículos y guías serán publicados pronto.
          </div>
        )}
      </div>
      
    </div>
  </main>

  <Footer />
</Layout>
