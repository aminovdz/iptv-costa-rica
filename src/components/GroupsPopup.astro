---
import { MessageSquare, Send, X } from 'lucide-astro';
---
<div id="groups-popup" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="glass-panel w-full max-w-md mx-4 rounded-3xl p-8 relative scale-95 transition-transform duration-300 groups-content border border-white/10 shadow-2xl text-center">
    
    <button id="close-groups-popup" class="absolute top-4 right-4 text-textSecondary hover:text-white transition-colors" aria-label="Cerrar">
      <X class="w-6 h-6" aria-hidden="true"/>
    </button>
    
    <h3 class="text-2xl font-bold text-white mb-2">¡Únase a nuestra Comunidad!</h3>
    <p class="text-textSecondary text-sm mb-8">
      Reciba ofertas exclusivas, actualizaciones de canales y avisos de eventos deportivos en vivo antes que nadie.
    </p>
    
    <div class="flex flex-col gap-4">
      <a href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-full font-bold transition-all">
        <MessageSquare class="w-5 h-5" aria-hidden="true" />
        Canal de WhatsApp
      </a>
      <a href="https://t.me/castvera_com" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 w-full bg-blue-500 hover:bg-blue-600 text-white py-3 rounded-full font-bold transition-all">
        <Send class="w-5 h-5" aria-hidden="true" />
        Canal de Telegram
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('groups-popup');
    const closeBtn = document.getElementById('close-groups-popup');
    const content = popup?.querySelector('.groups-content');
    
    const check24h = (key: string) => {
      const lastShown = localStorage.getItem(key);
      if (!lastShown) return true;
      const now = new Date().getTime();
      const hours24 = 24 * 60 * 60 * 1000;
      return (now - parseInt(lastShown)) > hours24;
    };
    
    const set24h = (key: string) => {
      localStorage.setItem(key, new Date().getTime().toString());
    };

    const closePopup = () => {
      popup?.classList.remove('opacity-100');
      popup?.classList.add('opacity-0', 'pointer-events-none');
      content?.classList.remove('scale-100');
      content?.classList.add('scale-95');
      popup?.setAttribute('aria-hidden', 'true');
    };

    if (popup && check24h('groups_popup_shown')) {
      // Trigger after 20 seconds
      setTimeout(() => {
        // Don't show if exit popup is currently visible
        if (document.getElementById('exit-popup')?.classList.contains('opacity-100')) return;
        
        popup.classList.remove('opacity-0', 'pointer-events-none');
        popup.classList.add('opacity-100');
        content?.classList.remove('scale-95');
        content?.classList.add('scale-100');
        popup.setAttribute('aria-hidden', 'false');
        set24h('groups_popup_shown');
      }, 20000); 
    }

    closeBtn?.addEventListener('click', closePopup);
  });
</script>
