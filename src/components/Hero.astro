---
import { CheckCircle2, Star, PlayCircle } from 'lucide-astro';
---
<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden" aria-labelledby="hero-heading">
  <!-- Background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/20 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <!-- Pura Vida Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8 backdrop-blur-md">
      <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse" aria-hidden="true"></span>
      <span class="text-xs font-semibold uppercase tracking-wider text-green-400">Pura Vida Streaming</span>
    </div>
    
    <h1 id="hero-heading" class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 bg-gradient-to-br from-white to-textSecondary bg-clip-text text-transparent max-w-4xl mx-auto leading-tight">
      IPTV Costa Rica — Todos los Canales Ticos e Internacionales en HD, 4K y 8K
    </h1>

    <div class="my-8 max-w-4xl mx-auto">
      <img 
        src="/og-image.jpg" 
        alt="Plataforma de iptv costa rica con transmisión de deportes en vivo" 
        class="w-full h-[300px] md:h-[500px] object-cover rounded-xl" 
      />
    </div>
    
    <p class="text-lg md:text-xl text-textSecondary max-w-2xl mx-auto mb-10">
      La mejor televisión de Costa Rica, sin cables y sin complicaciones. Únete a miles de clientes ticos satisfechos y disfruta de la Liga FPD en vivo.
    </p>
    
    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="https://wa.me/18036582620" class="flex items-center gap-2 bg-secondary hover:bg-red-700 text-white px-8 py-4 rounded-full font-bold text-lg transition-all shadow-[0_0_20px_rgba(206,17,38,0.4)] hover:shadow-[0_0_30px_rgba(206,17,38,0.6)] hover:-translate-y-1 w-full sm:w-auto justify-center" aria-label="Pruebe Gratis 24 Horas por WhatsApp">
        <PlayCircle class="w-5 h-5" aria-hidden="true" />
        Pruebe Gratis por 24 Horas
      </a>
      <a href="/precios" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-full font-bold text-lg transition-all border border-white/10 w-full sm:w-auto justify-center" aria-label="Ver Planes y Precios">
        Ver Planes y Precios
      </a>
    </div>
    
    <!-- Trust Signals -->
    <div class="mt-14 flex flex-wrap justify-center items-center gap-x-8 gap-y-4 text-sm text-textSecondary font-medium">
      <div class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-green-500" aria-hidden="true" /> Aceptamos Tarjetas y Cripto</div>
      <div class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-green-500" aria-hidden="true" /> Activación Inmediata</div>
      <div class="flex items-center gap-1.5">
        <div class="flex text-yellow-400" aria-hidden="true"><Star class="w-4 h-4 fill-current"/><Star class="w-4 h-4 fill-current"/><Star class="w-4 h-4 fill-current"/><Star class="w-4 h-4 fill-current"/><Star class="w-4 h-4 fill-current"/></div>
        <span class="ml-1 text-textPrimary">5.0 de 500+ Ticos</span>
      </div>
    </div>
  </div>
</section>
