---
import { BellRing } from 'lucide-astro';
---
<div id="social-popup" class="fixed bottom-6 left-6 z-[90] glass-panel p-4 rounded-xl shadow-2xl border-l-4 border-l-green-500 transform translate-y-[150%] opacity-0 transition-all duration-500 flex items-center gap-4 max-w-sm pointer-events-none" aria-hidden="true" role="status">
  <div class="w-10 h-10 bg-green-500/20 rounded-full flex items-center justify-center shrink-0">
    <BellRing class="w-5 h-5 text-green-500" aria-hidden="true"/>
  </div>
  <div>
    <p class="text-white text-sm font-bold" id="social-popup-name">Alguien de San José</p>
    <p class="text-textSecondary text-xs">acaba de comprar el Plan de 12 Meses.</p>
    <p class="text-green-400 text-[10px] mt-1 font-medium">Hace 2 minutos</p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const check24h = (key: string) => {
      const lastShown = localStorage.getItem(key);
      if (!lastShown) return true;
      const now = new Date().getTime();
      const hours24 = 24 * 60 * 60 * 1000;
      return (now - parseInt(lastShown)) > hours24;
    };
    
    const set24h = (key: string) => {
      localStorage.setItem(key, new Date().getTime().toString());
    };

    const cities = ["San José", "Alajuela", "Cartago", "Heredia", "Guanacaste"];
    const randomCity = cities[Math.floor(Math.random() * cities.length)];
    
    const popup = document.getElementById('social-popup');
    const nameEl = document.getElementById('social-popup-name');
    
    if (popup && nameEl && check24h('social_proof_shown')) {
      nameEl.textContent = `Alguien de ${randomCity}`;
      
      setTimeout(() => {
        popup.classList.remove('translate-y-[150%]', 'opacity-0');
        popup.setAttribute('aria-hidden', 'false');
        set24h('social_proof_shown');
        
        // Hide after 6 seconds
        setTimeout(() => {
          popup.classList.add('translate-y-[150%]', 'opacity-0');
          popup.setAttribute('aria-hidden', 'true');
        }, 6000);
      }, 8000); // Trigger 8 seconds after page load
    }
  });
</script>
