---
import { CheckCircle2, Zap, Gift } from 'lucide-astro';

// ALL plans have identical features as requested
const coreFeatures = [
  "Todos los Canales Ticos e Internacionales",
  "Deportes en Vivo: Liga FPD y La Sele",
  "Calidad HD, 4K y 8K garantizada",
  "Catálogo masivo de VOD (Películas/Series)",
  "Activación Rápida Segura",
  "Soporte VIP por WhatsApp",
  "Sin contratos ni penalidades"
];

const plans = [
  {
    name: "12 Meses",
    price: "35",
    currency: "USD",
    popular: true,
    badge: "Mejor Valor",
    features: [
      ...coreFeatures,
      "🌟 Aplicación Premium Gratis (Valor $15)"
    ]
  },
  {
    name: "6 Meses",
    price: "20",
    currency: "USD",
    popular: false,
    features: coreFeatures
  },
  {
    name: "3 Meses",
    price: "10",
    currency: "USD",
    popular: false,
    features: coreFeatures
  },
  {
    name: "1 Mes",
    price: "5",
    currency: "USD",
    popular: false,
    features: coreFeatures
  }
];
---
<section class="py-24 relative" id="precios" aria-labelledby="pricing-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="pricing-heading" class="text-3xl md:text-4xl font-bold mb-4 text-white">Planes y Precios IPTV Costa Rica</h2>
      <p class="text-textSecondary text-lg">Cancele cuando quiera. El mismo contenido premium en todos los planes.</p>
    </div>

    <!-- Pricing Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto items-start">
      {plans.map((plan) => (
        <div class={`relative glass-panel rounded-2xl p-8 flex flex-col h-full transition-transform hover:-translate-y-2 ${plan.popular ? 'border-primary/50 shadow-[0_0_30px_rgba(0,43,127,0.3)] lg:-mt-4 lg:mb-4' : 'border-white/5'}`}>
          
          {plan.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary text-white px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider flex items-center gap-1 shadow-lg">
              <Zap class="w-3 h-3 fill-current" aria-hidden="true" />
              {plan.badge}
            </div>
          )}

          <div class="mb-8">
            <h3 class="text-xl font-medium text-textPrimary mb-2">{plan.name}</h3>
            <div class="flex items-baseline gap-1">
              <span class="text-3xl font-bold text-white">$</span>
              <span class="text-5xl font-extrabold text-white tracking-tight">{plan.price}</span>
              <span class="text-textSecondary font-medium">/{plan.currency}</span>
            </div>
            {plan.popular && (
              <p class="text-green-400 text-sm font-medium mt-2 flex items-center gap-1"><Gift class="w-4 h-4"/> ¡App Premium Incluida!</p>
            )}
          </div>

          <ul class="space-y-4 mb-8 flex-1" aria-label={`Características del plan ${plan.name}`}>
            {plan.features.map(feature => (
              <li class="flex items-start gap-3 text-textSecondary text-sm">
                <CheckCircle2 class="w-5 h-5 text-green-500 shrink-0" aria-hidden="true" />
                <span class={feature.includes('Aplicación Premium Gratis') ? 'font-bold text-white' : ''}>{feature}</span>
              </li>
            ))}
          </ul>

          <a href="https://wa.me/18036582620" class={`w-full py-4 px-6 rounded-full font-bold text-center transition-all ${plan.popular ? 'bg-secondary hover:bg-red-700 text-white shadow-lg' : 'bg-white/10 hover:bg-white/20 text-white'}`} aria-label={`Contratar plan ${plan.name} por WhatsApp`}>
            Contratar Ahora
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
