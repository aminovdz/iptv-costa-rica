---
import { MonitorPlay, Trophy, Zap, Smartphone } from 'lucide-astro';

const features = [
  {
    title: "Todos los Canales Ticos",
    description: "Disfrute de Teletica, Repretel, TD Más y Canal UCR en alta definición, sin interrupciones.",
    icon: MonitorPlay
  },
  {
    title: "La Liga FPD y La Sele",
    description: "No se pierda ningún clásico. Vea todos los partidos de Saprissa, La Liga y Herediano en vivo.",
    icon: Trophy
  },
  {
    title: "Calidad 4K sin Buffer",
    description: "Nuestros servidores premium garantizan una transmisión fluida en resoluciones HD, 4K y 8K.",
    icon: Zap
  },
  {
    title: "Tarjetas y Cripto y Más",
    description: "Pague fácilmente con Tarjetas y Cripto, transferencia bancaria o PayPal. Activación en 5 minutos.",
    icon: Smartphone
  }
];
---
<section class="py-24 relative" id="caracteristicas" aria-labelledby="features-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="features-heading" class="text-3xl md:text-4xl font-bold mb-4 text-white">
        ¿Por qué elegir nuestro servicio IPTV en Costa Rica?
      </h2>
      <p class="text-textSecondary text-lg">
        Diseñado para brindar la experiencia más estable y completa del mercado, con un enfoque 100% Pura Vida.
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map(feature => (
        <div class="glass-panel p-8 rounded-2xl hover:-translate-y-2 transition-transform duration-300 group">
          <div class="w-14 h-14 bg-primary/20 rounded-xl flex items-center justify-center mb-6 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
            <feature.icon class="w-7 h-7" aria-hidden="true" />
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{feature.title}</h3>
          <p class="text-textSecondary text-sm leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
