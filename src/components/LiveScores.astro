---
import { Activity, ExternalLink, ChevronRight, Trophy } from 'lucide-astro';

interface Fixture {
  id: string;
  league: string;
  leagueShort: string;
  date: string;
  status: string;
  isLive: boolean;
  homeTeam: string;
  homeScore: string;
  homeLogo: string;
  awayTeam: string;
  awayScore: string;
  awayLogo: string;
}

const fallbackFixtures: Fixture[] = [
  {
    id: 'cr-1',
    league: 'Liga Promerica (FPD)',
    leagueShort: 'FPD',
    date: 'En Vivo',
    status: '68\'',
    isLive: true,
    homeTeam: 'Alajuelense',
    homeScore: '2',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/2057.png',
    awayTeam: 'Saprissa',
    awayScore: '1',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/2058.png'
  },
  {
    id: 'cr-2',
    league: 'Liga Promerica (FPD)',
    leagueShort: 'FPD',
    date: 'Final',
    status: 'FT',
    isLive: false,
    homeTeam: 'Herediano',
    homeScore: '3',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/2060.png',
    awayTeam: 'Cartaginés',
    awayScore: '1',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/2059.png'
  },
  {
    id: 'ucl-1',
    league: 'UEFA Champions League',
    leagueShort: 'UCL',
    date: 'Final',
    status: 'FT',
    isLive: false,
    homeTeam: 'Real Madrid',
    homeScore: '3',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/86.png',
    awayTeam: 'Bayern München',
    awayScore: '2',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/132.png'
  },
  {
    id: 'esp-1',
    league: 'Spanish LaLiga',
    leagueShort: 'LaLiga',
    date: 'Final',
    status: 'FT',
    isLive: false,
    homeTeam: 'Barcelona',
    homeScore: '4',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/83.png',
    awayTeam: 'Atlético Madrid',
    awayScore: '1',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/1068.png'
  },
  {
    id: 'eng-1',
    league: 'Premier League',
    leagueShort: 'EPL',
    date: 'Final',
    status: 'FT',
    isLive: false,
    homeTeam: 'Liverpool',
    homeScore: '2',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/364.png',
    awayTeam: 'Manchester City',
    awayScore: '2',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/382.png'
  }
];

let fixtures: Fixture[] = [];

try {
  const leagues = [
    { id: 'crc.1', name: 'Liga Promerica (FPD)', short: 'FPD' },
    { id: 'uefa.champions', name: 'Champions League', short: 'UCL' },
    { id: 'esp.1', name: 'LaLiga', short: 'LaLiga' },
    { id: 'eng.1', name: 'Premier League', short: 'EPL' },
    { id: 'ned.1', name: 'Eredivisie', short: 'Eredivisie' }
  ];

  const results = await Promise.all(leagues.map(async (l) => {
    try {
      const res = await fetch(`https://site.api.espn.com/apis/site/v2/sports/soccer/${l.id}/scoreboard`);
      if (!res.ok) return [];
      const data = await res.json();
      return (data.events || []).map((e: any) => {
        const comp = e.competitions?.[0];
        const home = comp?.competitors?.find((c: any) => c.homeAway === 'home');
        const away = comp?.competitors?.find((c: any) => c.homeAway === 'away');
        const rawStatus = e.status?.type?.shortDetail || 'TBD';
        const isLive = e.status?.type?.state === 'in' || rawStatus.includes('\'') || rawStatus === 'HT';

        return {
          id: e.id,
          league: l.name,
          leagueShort: l.short,
          date: e.date,
          status: rawStatus,
          isLive,
          homeTeam: home?.team?.shortDisplayName || home?.team?.name || 'Local',
          homeScore: home?.score !== undefined ? String(home.score) : '-',
          homeLogo: home?.team?.logo || '',
          awayTeam: away?.team?.shortDisplayName || away?.team?.name || 'Visita',
          awayScore: away?.score !== undefined ? String(away.score) : '-',
          awayLogo: away?.team?.logo || ''
        };
      });
    } catch {
      return [];
    }
  }));

  const flat = results.flat();
  fixtures = flat.length > 0 ? flat : fallbackFixtures;
} catch (e) {
  console.error("Error fetching live scores:", e);
  fixtures = fallbackFixtures;
}

// Guarantee sufficient cards to produce a truly seamless infinite loop
while (fixtures.length < 8) {
  fixtures = [...fixtures, ...fallbackFixtures];
}
---

<section 
  class="relative py-4 border-y border-white/10 bg-background/80 backdrop-blur-md overflow-hidden select-none" 
  aria-label="Marcadores y Match Center en Vivo"
>
  <!-- Background Glow Accents -->
  <div class="absolute -left-20 top-1/2 -translate-y-1/2 w-48 h-48 bg-primary/20 blur-[80px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -right-20 top-1/2 -translate-y-1/2 w-48 h-48 bg-secondary/20 blur-[80px] pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-3 flex flex-wrap items-center justify-between gap-3">
    <!-- Header with Pulse Indicator -->
    <a 
      href="/livescore" 
      class="group inline-flex items-center gap-2.5 text-white hover:text-primary transition-colors focus:outline-none focus:ring-2 focus:ring-primary/50 rounded-lg py-1 px-1.5"
      title="Ir al Match Center en Vivo"
    >
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
      </span>
      <span class="text-xs sm:text-sm font-extrabold tracking-wide uppercase flex items-center gap-1.5">
        Marcadores en Vivo
        <span class="hidden sm:inline-block text-xs font-semibold px-2 py-0.5 rounded-full bg-red-500/20 text-red-400 border border-red-500/30">
          Match Center
        </span>
      </span>
    </a>

    <!-- Direct CTA Link to Match Center -->
    <a 
      href="/livescore" 
      class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-textSecondary hover:text-white group transition-colors"
      title="Abrir Match Center Completo"
    >
      <span>Ver Match Center Completo</span>
      <ChevronRight class="w-4 h-4 text-primary group-hover:translate-x-1 transition-transform" />
    </a>
  </div>

  <!-- Infinite Loop Carousel Wrapper -->
  <div class="relative w-full overflow-hidden mask-edges group">
    <!-- Animated Track: Duplicate list seamlessly (fixtures + fixtures) -->
    <div class="flex items-center gap-4 w-max marquee-track group-hover:[animation-play-state:paused] focus-within:[animation-play-state:paused]">
      {/* Set 1 */}
      {fixtures.map((fixture) => (
        <a 
          href="/livescore" 
          class="fixture-card glass-panel border border-white/10 hover:border-primary/50 hover:bg-white/[0.07] px-4 py-2.5 rounded-xl flex items-center gap-4 shrink-0 transition-all duration-300 hover:scale-[1.02] shadow-lg group/card"
          title={`Ver detalles de ${fixture.homeTeam} vs ${fixture.awayTeam} en Match Center`}
        >
          {/* Status & League Tag */}
          <div class="flex flex-col items-center justify-center w-14 shrink-0 border-r border-white/10 pr-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-textSecondary group-hover/card:text-primary transition-colors truncate max-w-full">
              {fixture.leagueShort}
            </span>
            <span class={`text-[11px] font-semibold mt-0.5 ${fixture.isLive ? 'text-red-400 font-bold animate-pulse' : 'text-textSecondary'}`}>
              {fixture.status}
            </span>
          </div>

          {/* Teams and Scores */}
          <div class="flex flex-col gap-1.5 min-w-[130px]">
            {/* Home */}
            <div class="flex items-center justify-between gap-3 text-xs sm:text-sm">
              <div class="flex items-center gap-2 truncate max-w-[110px]">
                {fixture.homeLogo ? (
                  <img 
                    src={fixture.homeLogo} 
                    alt={`Logo ${fixture.homeTeam}`} 
                    class="w-4 h-4 object-contain shrink-0" 
                    loading="lazy" 
                    width="16" 
                    height="16"
                  />
                ) : (
                  <div class="w-4 h-4 rounded-full bg-white/10 shrink-0" />
                )}
                <span class="font-medium text-white truncate group-hover/card:text-white">{fixture.homeTeam}</span>
              </div>
              <span class="font-bold text-white tabular-nums px-1.5 py-0.5 rounded bg-white/5 border border-white/5 min-w-[20px] text-center">
                {fixture.homeScore}
              </span>
            </div>

            {/* Away */}
            <div class="flex items-center justify-between gap-3 text-xs sm:text-sm">
              <div class="flex items-center gap-2 truncate max-w-[110px]">
                {fixture.awayLogo ? (
                  <img 
                    src={fixture.awayLogo} 
                    alt={`Logo ${fixture.awayTeam}`} 
                    class="w-4 h-4 object-contain shrink-0" 
                    loading="lazy" 
                    width="16" 
                    height="16"
                  />
                ) : (
                  <div class="w-4 h-4 rounded-full bg-white/10 shrink-0" />
                )}
                <span class="font-medium text-white truncate group-hover/card:text-white">{fixture.awayTeam}</span>
              </div>
              <span class="font-bold text-white tabular-nums px-1.5 py-0.5 rounded bg-white/5 border border-white/5 min-w-[20px] text-center">
                {fixture.awayScore}
              </span>
            </div>
          </div>

          <div class="hidden sm:flex flex-col items-center justify-center pl-1 text-textSecondary/40 group-hover/card:text-primary transition-colors">
            <ExternalLink class="w-3.5 h-3.5" />
          </div>
        </a>
      ))}

      {/* Set 2 (Exact Duplicate to achieve mathematically seamless continuous loop) */}
      {fixtures.map((fixture) => (
        <a 
          href="/livescore" 
          class="fixture-card glass-panel border border-white/10 hover:border-primary/50 hover:bg-white/[0.07] px-4 py-2.5 rounded-xl flex items-center gap-4 shrink-0 transition-all duration-300 hover:scale-[1.02] shadow-lg group/card"
          aria-hidden="true"
          tabindex="-1"
          title={`Ver detalles de ${fixture.homeTeam} vs ${fixture.awayTeam} en Match Center`}
        >
          {/* Status & League Tag */}
          <div class="flex flex-col items-center justify-center w-14 shrink-0 border-r border-white/10 pr-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-textSecondary group-hover/card:text-primary transition-colors truncate max-w-full">
              {fixture.leagueShort}
            </span>
            <span class={`text-[11px] font-semibold mt-0.5 ${fixture.isLive ? 'text-red-400 font-bold animate-pulse' : 'text-textSecondary'}`}>
              {fixture.status}
            </span>
          </div>

          {/* Teams and Scores */}
          <div class="flex flex-col gap-1.5 min-w-[130px]">
            {/* Home */}
            <div class="flex items-center justify-between gap-3 text-xs sm:text-sm">
              <div class="flex items-center gap-2 truncate max-w-[110px]">
                {fixture.homeLogo ? (
                  <img 
                    src={fixture.homeLogo} 
                    alt="" 
                    class="w-4 h-4 object-contain shrink-0" 
                    loading="lazy" 
                    width="16" 
                    height="16"
                  />
                ) : (
                  <div class="w-4 h-4 rounded-full bg-white/10 shrink-0" />
                )}
                <span class="font-medium text-white truncate">{fixture.homeTeam}</span>
              </div>
              <span class="font-bold text-white tabular-nums px-1.5 py-0.5 rounded bg-white/5 border border-white/5 min-w-[20px] text-center">
                {fixture.homeScore}
              </span>
            </div>

            {/* Away */}
            <div class="flex items-center justify-between gap-3 text-xs sm:text-sm">
              <div class="flex items-center gap-2 truncate max-w-[110px]">
                {fixture.awayLogo ? (
                  <img 
                    src={fixture.awayLogo} 
                    alt="" 
                    class="w-4 h-4 object-contain shrink-0" 
                    loading="lazy" 
                    width="16" 
                    height="16"
                  />
                ) : (
                  <div class="w-4 h-4 rounded-full bg-white/10 shrink-0" />
                )}
                <span class="font-medium text-white truncate">{fixture.awayTeam}</span>
              </div>
              <span class="font-bold text-white tabular-nums px-1.5 py-0.5 rounded bg-white/5 border border-white/5 min-w-[20px] text-center">
                {fixture.awayScore}
              </span>
            </div>
          </div>

          <div class="hidden sm:flex flex-col items-center justify-center pl-1 text-textSecondary/40 group-hover/card:text-primary transition-colors">
            <ExternalLink class="w-3.5 h-3.5" />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Seamless Infinite Carousel Animation */
  @keyframes loopMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    animation: loopMarquee 45s linear infinite;
    will-change: transform;
  }

  /* Fade out edges for ultra-premium look */
  .mask-edges {
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 4%,
      black 96%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 4%,
      black 96%,
      transparent 100%
    );
  }

  /* Accessibility: reduce motion respect */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      overflow-x: auto;
    }
  }
</style>
