---
import { Tv, Smartphone, Laptop, Box } from 'lucide-astro';

const devices = [
  { name: "Smart TVs", description: "Televisores inteligentes con Android TV, Tizen o WebOS.", icon: Tv },
  { name: "TV Boxes", description: "Cualquier caja Android, Fire Stick o dispositivo de streaming.", icon: Box },
  { name: "Dispositivos Móviles", description: "Teléfonos y tabletas iOS o Android para ver donde quiera.", icon: Smartphone },
  { name: "Computadoras", description: "Acceso web directo desde Windows o macOS.", icon: Laptop }
];
---
<section class="py-24 relative overflow-hidden" aria-labelledby="devices-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      
      <div class="lg:w-1/2">
        <h2 id="devices-heading" class="text-3xl md:text-4xl font-bold mb-6 text-white">
          Compatible con Todos sus Dispositivos
        </h2>
        <p class="text-textSecondary text-lg mb-8 leading-relaxed">
          Nuestra tecnología es completamente multiplataforma. No necesita comprar equipos nuevos; nuestro servicio de IPTV funciona en las pantallas que ya tiene en casa.
        </p>
        
        <div class="grid sm:grid-cols-2 gap-6">
          {devices.map(device => (
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center shrink-0">
                <device.icon class="w-6 h-6 text-primary" aria-hidden="true" />
              </div>
              <div>
                <h3 class="text-white font-bold mb-1">{device.name}</h3>
                <p class="text-textSecondary text-sm">{device.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Abstract Image / Graphic Placeholder -->
      <div class="lg:w-1/2 w-full relative">
        <div class="aspect-square max-w-md mx-auto relative">
          <div class="absolute inset-0 bg-gradient-to-tr from-primary to-secondary rounded-[3rem] rotate-6 opacity-20 blur-xl animate-pulse" aria-hidden="true"></div>
          <div class="absolute inset-0 glass-panel rounded-[3rem] border border-white/10 flex items-center justify-center shadow-2xl overflow-hidden">
            <Tv class="w-32 h-32 text-white/20" aria-hidden="true" />
            <div class="absolute bottom-0 left-0 w-full h-1/3 bg-gradient-to-t from-black/50 to-transparent"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
